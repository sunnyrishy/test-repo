# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/job_agent

# AI verification. Providers: openai | anthropic | mock.
# "mock" performs no reasoning and is for development only - it leaves every
# semantic check UNKNOWN, so its jobs land in REVIEW rather than on the
# dashboard. Set a real provider and model before relying on results.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_MAX_ATTEMPTS=3
AI_CONCURRENCY=4

# Re-verify a job when its verification is older than this many days.
VERIFICATION_MAX_AGE_DAYS=7
VERIFICATION_BATCH_SIZE=50

# Pipeline thresholds
JOB_DISCOVERY_INTERVAL_MINUTES=180
MAX_JOB_AGE_HOURS=72
MIN_MATCH_SCORE=80
NOTIFICATION_MIN_SCORE=90

# Source connectors: comma-separated "source:board_token" entries.
# Greenhouse/Lever/Ashby expose public JSON job boards keyed by a company token.
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# Per-source HTTP behaviour
SOURCE_REQUEST_TIMEOUT_SECONDS=20
SOURCE_MAX_RETRIES=3
SOURCE_RATE_LIMIT_PER_SECOND=2
SOURCE_CONCURRENCY=4

# Notifications. A channel is enabled only when its variables are set;
# digests are sent once per job per channel, never one email per job.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
